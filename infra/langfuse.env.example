# Скопировать в ../.env.langfuse и заменить все значения CHANGE_ME перед запуском.
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
POSTGRES_DB=langfuse
DATABASE_URL=postgresql://langfuse:CHANGE_ME_POSTGRES@lf-postgres:5432/langfuse
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_32_CHARS
SALT=CHANGE_ME_SALT_32_CHARS
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=CHANGE_ME_CLICKHOUSE
CLICKHOUSE_URL=http://lf-clickhouse:8123
CLICKHOUSE_MIGRATION_URL=clickhouse://lf-clickhouse:9000
CLICKHOUSE_CLUSTER_ENABLED=false
REDIS_HOST=lf-redis
REDIS_PORT=6379
REDIS_AUTH=CHANGE_ME_REDIS
MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_REGION=auto
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://lf-minio:9000
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=langfuse
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=CHANGE_ME_MINIO
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_REGION=auto
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://lf-minio:9000
LANGFUSE_S3_MEDIA_UPLOAD_INTERNAL_ENDPOINT=http://lf-minio:9000
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=CHANGE_ME_MINIO
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true
TELEMETRY_ENABLED=false
LANGFUSE_IN_APP_AGENT_ENABLED=false
# Base64 от «публичный_ключ:секретный_ключ» проекта Langfuse.
LANGFUSE_AUTH_BASE64=CHANGE_ME_AFTER_PROJECT_CREATION
