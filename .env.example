# Base Compose configuration; GPU deployment uses docs/operations.md and .env.benchmark.
# model is a private Docker DNS name; use an actual reachable private endpoint for your topology.
APP_MODE=connected
DATABASE_URL=postgresql://research:research-dev-only@localhost:5434/research
QDRANT_URL=http://localhost:6333
FILE_ROOT=./data/files
PDF_PARSER=auto
DOCLING_ARTIFACTS_PATH=
MODEL_BASE_URL=http://model:8000/v1
VISION_BASE_URL=http://model:8000/v1
MODEL_API_KEY=
TEXT_MODEL=research-text
VISION_MODEL=research-text
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
OPENROUTER_EMBEDDING_MODEL=baai/bge-m3
FRONTEND_ORIGIN=http://localhost:5173
BOOTSTRAP_EMAIL=admin@example.local
BOOTSTRAP_PASSWORD=
# Необязательно: секреты из OpenBao KV v2; внешний OpenBao требует HTTPS.
OPENBAO_URL=
OPENBAO_TOKEN_FILE=
OPENBAO_SECRET_PATH=secret/data/research

# Original image pixels are not PII-redacted. Enable only for a vetted public corpus.
ALLOW_EXTERNAL_IMAGES=false
RESEARCH_TIMEOUT_SECONDS=3600
# Per model request; longer local reports may need more time.
MODEL_REQUEST_TIMEOUT_SECONDS=90
INTERNET_SEARCH_ENABLED=false
# Optional output cap and OpenRouter reasoning effort; omit to preserve defaults.
# MODEL_MAX_OUTPUT_TOKENS=4096
# MODEL_REASONING_EFFORT=none
# Optional bounded identifier-graph retrieval; requires indexing the corpus.
GRAPH_RETRIEVAL_ENABLED=false
QWEN_RERANK_MIN_PROBABILITY=0.1
